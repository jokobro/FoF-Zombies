            <engine:VisualElement name="BottomLine" style="flex-grow: 1; position: absolute; height: 25px; width: 2px; top: 30px; left: 0; right: 0; bottom: 0; background-image: url(&quot;project://database/Assets/Assets/Pickups/Max%20ammo%20Pickups/Ammo_initialShadingGroup_Metalness.png?fileID=2800000&amp;guid=daa016f244654a348b8d5a8686d9a5c5&amp;type=3#Ammo_initialShadingGroup_Metalness&quot;); margin-left: -1px;" />
