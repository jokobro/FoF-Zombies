        <engine:Label text="0/0&#10;" name="ammoLabel" class="text" style="position: absolute; top: 935px; left: 1695px; height: 77px; width: 187px; font-size: 55px; -unity-text-align: upper-left; color: rgb(255, 255, 255);" />
        <engine:Label text="0&#10;" name="waveLabel" class="text" style="position: absolute; top: 0; left: 1px; color: rgb(255, 255, 255); font-size: 55px; -unity-text-align: upper-center; height: 73px; width: 122px;" />
