<engine:UXML xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xmlns:engine="UnityEngine.UIElements" xmlns:editor="UnityEditor.UIElements" noNamespaceSchemaLocation="../../../UIElementsSchema/UIElements.xsd" editor-extension-mode="False">
    <Style src="project://database/Assets/UI%20Toolkit/uss.uss?fileID=7433441132597879392&amp;guid=ef6ef6e95a2fd0d4281d12c6f0c78462&amp;type=3#uss" />
    <engine:VisualElement name="HUDContainer" style="flex-grow: 1;">
        <engine:Label text="Label" name="scoreLabel" class="text" style="position: absolute; top: 362px; left: 1012px; color: rgb(255, 255, 255); font-size: 31px;" />
        <engine:Label text="0/0&#10;" name="ammoLabel" class="text" style="position: absolute; top: 414px; left: 961px; height: 42px; width: 135px; font-size: 30px; -unity-text-align: upper-left; color: rgb(255, 255, 255);" />
        <engine:Label text="0&#10;" name="waveLabel" class="text" style="position: absolute; top: 0; left: 1px; color: rgb(255, 255, 255); font-size: 31px; -unity-text-align: upper-center; height: 42px; width: 78px;" />
        <engine:VisualElement name="PerkSlot1" style="flex-grow: 1; position: absolute; height: 45px; width: 75px; top: 446px; left: 5px; background-image: none;" />
        <engine:VisualElement name="PerkSlot2" style="flex-grow: 1; position: absolute; height: 45px; width: 75px; top: 446px; left: 90px; background-image: none;" />
        <engine:VisualElement name="PerkSlot3" style="flex-grow: 1; position: absolute; height: 45px; width: 75px; top: 446px; left: 175px; right: 855px; background-image: none;" />
        <engine:VisualElement name="PerkSlot4" style="flex-grow: 1; position: absolute; height: 45px; width: 75px; top: 446px; left: 260px; right: 855px; background-image: none;" />
        <engine:Label text="Label" name="InteractionText" class="text" style="position: absolute; top: 204px; left: 457px; font-size: 20px; width: 150px; color: rgb(255, 254, 254);" />
        <engine:VisualElement name="crosshair" style="flex-grow: 1; position: absolute; width: 0; height: 0; left: 50%; right: auto; top: 50%; translate: -50px -50px;">
            <engine:VisualElement name="Topline" class="image" style="flex-grow: 1; position: absolute; height: 25px; width: 2px; top: -15px; left: 0; right: 0; bottom: 0; background-image: url(&quot;project://database/Assets/Assets/Pickups/Max%20ammo%20Pickups/Ammo_initialShadingGroup_Metalness.png?fileID=2800000&amp;guid=daa016f244654a348b8d5a8686d9a5c5&amp;type=3#Ammo_initialShadingGroup_Metalness&quot;);" />
            <engine:VisualElement name="Bottomline" style="flex-grow: 1; position: absolute; height: 25px; width: 2px; top: 15px; left: 0; right: 0; bottom: 0; background-image: url(&quot;project://database/Assets/Assets/Pickups/Max%20ammo%20Pickups/Ammo_initialShadingGroup_Metalness.png?fileID=2800000&amp;guid=daa016f244654a348b8d5a8686d9a5c5&amp;type=3#Ammo_initialShadingGroup_Metalness&quot;);" />
            <engine:VisualElement name="Leftline" style="flex-grow: 1; position: absolute; height: 25px; width: 2px; top: 0; left: -15px; right: 0; bottom: 0; background-image: url(&quot;project://database/Assets/Assets/Pickups/Max%20ammo%20Pickups/Ammo_initialShadingGroup_Metalness.png?fileID=2800000&amp;guid=daa016f244654a348b8d5a8686d9a5c5&amp;type=3#Ammo_initialShadingGroup_Metalness&quot;);" />
            <engine:VisualElement name="Rightline" style="flex-grow: 1; position: absolute; height: 25px; width: 2px; top: 0; left: 15px; right: 0; bottom: 0; background-image: url(&quot;project://database/Assets/Assets/Pickups/Max%20ammo%20Pickups/Ammo_initialShadingGroup_Metalness.png?fileID=2800000&amp;guid=daa016f244654a348b8d5a8686d9a5c5&amp;type=3#Ammo_initialShadingGroup_Metalness&quot;);" />
        </engine:VisualElement>
    </engine:VisualElement>
    <engine:VisualElement name="PauseScreen" class="background-color" style="flex-grow: 1; height: 512px; width: 1109px; position: absolute; top: -2px; left: -8px; -unity-background-image-tint-color: rgb(24, 21, 21); color: rgb(27, 27, 27); background-color: rgb(166, 166, 166);">
